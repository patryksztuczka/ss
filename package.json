{
  "name": "ss",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "dev": "vp run --filter @ss/desktop dev",
    "build": "vp run --filter './apps/*' build",
    "dist": "vp run --filter @ss/desktop dist",
    "typecheck": "vp run --filter './apps/*' typecheck",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "test": "vp test"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.17.0"
}

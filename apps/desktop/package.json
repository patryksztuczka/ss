{
  "name": "@ss/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Lightweight, shortcut-driven screenshots and screen recordings for macOS",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "start": "node scripts/start-electron.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "effect": "catalog:",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "build": {
    "appId": "dev.sztuczka.ss",
    "productName": "ss",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist-electron/**/*",
      "!dist-electron/**/*.map",
      "package.json"
    ],
    "asarUnpack": [
      "dist-electron/bin/**"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "trayTemplate*.png"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "icon": "resources/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "extendInfo": {
        "LSUIElement": true
      }
    }
  },
  "productName": "ss"
}
